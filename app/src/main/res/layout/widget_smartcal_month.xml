<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/monthWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="2dp">

    <!-- One UI 9 Soft Squircle Surface synced with App Design Theme -->
    <ImageView
        android:id="@+id/monthWidgetBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Smart Cal Monthly Widget" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- One UI 9 Crisp Month Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/monthPrevBtn"
                android:layout_width="38dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="‹"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#64748B" />

            <TextView
                android:id="@+id/monthTitleBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="آذر ۱۴۰۵"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#0F172A" />

            <TextView
                android:id="@+id/monthNextBtn"
                android:layout_width="38dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="›"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#64748B" />
        </LinearLayout>

        <!-- Edge-to-Edge High-DPI Calendar Grid (Large Readable Numbers + Holidays + Event Dots) -->
        <ImageView
            android:id="@+id/monthGridImage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scaleType="fitXY"
            android:contentDescription="Monthly Calendar Grid" />
    </LinearLayout>
</FrameLayout>
